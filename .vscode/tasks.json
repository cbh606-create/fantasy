{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "localhost",
      "type": "shell",
      "command": "if (netstat -ano | Select-String ':3000\\s+.*LISTENING') { Write-Output 'Starting...'; Write-Output 'Ready — already at http://localhost:3000' } else { npm run dev }",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next-dev",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting\\.\\.\\.",
          "endsPattern": "Ready"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
