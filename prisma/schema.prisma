generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model League {
  id           String   @id @default(cuid())
  clerkUserId  String
  name         String
  settingsJson String
  stateJson    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clerkUserId])
}
